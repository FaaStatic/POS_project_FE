# Copy to .env.dev, .env.staging and .env.prod (git-ignored, bundled as assets), setting FLAVOR to match. Placeholder values.
# Production API origin, filled at deploy time. Android emulator: http://10.0.2.2:3030, real phone: http://<IP-laptop>:3030.
API_BASE_URL=https://api.example.invalid
FLAVOR=dev
# API version in every URL: /api/{API_VERSION}/... Must equal the backend server.api_version; CI/CD rewrites it and rebuilds.
API_VERSION=v1
